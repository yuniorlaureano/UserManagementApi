@host = http://localhost:5024
@adminAuth = Basic YWRtaW46cGFzc3dvcmQ=
@userAuth = Basic dXNlcjpzZWNyZXQ=

### UserManagementAPI — CRUD + Basic auth tests
#
# Notes:
# - The API protects /users endpoints with Basic auth middleware
# - Example credentials:
#     admin:password
#     user:secret

### 1) List users (no auth) — expect 401 Unauthorized
GET {{host}}/users
Accept: application/json

### 2) List users (with Basic auth) — expect 200 OK
GET {{host}}/users
Authorization: {{adminAuth}}
Accept: application/json

### 3) Create a user (authenticated) — expect 201 Created
# @name createUser
POST {{host}}/users
Content-Type: application/json
Authorization: {{adminAuth}}

{
    "firstName": "Sam",
    "lastName": "Lee",
    "age": 28
}

###

@id = {{createUser.response.body.$.id}}

### 4) Get the created user by id (authenticated)
GET {{host}}/users/{{id}}
Authorization: {{adminAuth}}
Accept: application/json

### 5) Update the created user (authenticated) — expect 204 No Content
PUT {{host}}/users/{{id}}
Content-Type: application/json
Authorization: {{adminAuth}}

{
    "firstName": "Samantha",
    "lastName": "Lee",
    "age": 29
}

### 6) Delete the created user (authenticated) — expect 204 No Content
DELETE {{host}}/users/{{id}}
Authorization: {{adminAuth}}

### 7) Verify deletion — Get should return 404 Not Found
GET {{host}}/users/{{id}}
Authorization: {{adminAuth}}
Accept: application/json
